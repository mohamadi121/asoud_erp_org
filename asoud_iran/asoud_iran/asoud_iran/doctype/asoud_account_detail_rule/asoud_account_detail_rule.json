    {"fieldname": "detail_type", "label": "Allowed Detail Type", "fieldtype": "Select", "options": "Customer\nSupplier\nEmployee\nBank\nCashbox\nProject\nCost Center\nBranch\nOther", "reqd": 1, "in_list_view": 1},
