{
  "doctype": "DocType",
  "name": "ASOUD Employee Document",
  "module": "ASOUD HR",
  "autoname": "HR-DOC-.YYYY.-.#####",
  "track_changes": 1,
  "field_order": ["employee", "company", "document_type", "document_number", "file", "issued_on", "expires_on", "confidentiality", "status"],
  "fields": [
    {"fieldname": "employee", "label": "Employee", "fieldtype": "Link", "options": "Employee", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "fetch_from": "employee.company", "read_only": 1, "in_list_view": 1},
    {"fieldname": "document_type", "label": "Document Type", "fieldtype": "Select", "options": "Identity\nContract\nEducation\nInsurance\nMedical\nCertificate\nOther", "reqd": 1, "in_list_view": 1},
    {"fieldname": "document_number", "label": "Document Number", "fieldtype": "Data", "permlevel": 1},
    {"fieldname": "file", "label": "Private File", "fieldtype": "Attach", "reqd": 1},
    {"fieldname": "issued_on", "label": "Issued On", "fieldtype": "Date"},
    {"fieldname": "expires_on", "label": "Expires On", "fieldtype": "Date"},
    {"fieldname": "confidentiality", "label": "Confidentiality", "fieldtype": "Select", "options": "HR Only\nEmployee and HR\nManager and HR", "default": "Employee and HR", "reqd": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Active\nExpired\nReplaced\nArchived", "default": "Active", "reqd": 1, "in_list_view": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "permlevel": 0},
    {"role": "System Manager", "read": 1, "write": 1, "permlevel": 1},
    {"role": "ASOUD HR Manager", "read": 1, "write": 1, "create": 1, "permlevel": 0},
    {"role": "ASOUD HR Manager", "read": 1, "write": 1, "permlevel": 1},
    {"role": "ASOUD HR User", "read": 1, "write": 1, "create": 1},
    {"role": "ASOUD Employee", "read": 1},
    {"role": "ASOUD HR Auditor", "read": 1}
  ]
}

