{
  "doctype": "DocType",
  "name": "ASOUD Fiscal Period",
  "module": "ASOUD Core",
  "autoname": "ASOUD-PERIOD-.YYYY.-.#####",
  "title_field": "period_name",
  "track_changes": 1,
  "field_order": ["company", "fiscal_year", "period_name", "period_type", "from_date", "to_date", "enabled"],
  "fields": [
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "fiscal_year", "label": "Fiscal Year", "fieldtype": "Link", "options": "Fiscal Year", "reqd": 1, "in_list_view": 1},
    {"fieldname": "period_name", "label": "Period Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "period_type", "label": "Period Type", "fieldtype": "Select", "options": "Standard\nAdjustment", "default": "Standard", "reqd": 1},
    {"fieldname": "from_date", "label": "From Date", "fieldtype": "Date", "reqd": 1, "in_list_view": 1},
    {"fieldname": "to_date", "label": "To Date", "fieldtype": "Date", "reqd": 1, "in_list_view": 1},
    {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "1", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Accounts Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Accounts User", "read": 1}
  ]
}
