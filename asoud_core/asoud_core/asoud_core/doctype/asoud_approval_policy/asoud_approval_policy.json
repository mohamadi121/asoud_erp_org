{
  "doctype": "DocType",
  "name": "ASOUD Approval Policy",
  "module": "ASOUD Core",
  "autoname": "format:APR-POL-{#####}",
  "title_field": "policy_title",
  "track_changes": 1,
  "field_order": ["policy_title", "enabled", "document_type", "company", "branch", "effective_from", "effective_to", "minimum_amount", "maximum_amount", "priority", "policy_version", "allow_self_approval", "parallel_mode", "stages"],
  "fields": [
    {"fieldname": "policy_title", "label": "Policy Title", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "1", "in_list_view": 1},
    {"fieldname": "document_type", "label": "Document Type", "fieldtype": "Link", "options": "DocType", "reqd": 1, "in_list_view": 1},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "branch", "label": "Branch", "fieldtype": "Link", "options": "ASOUD Branch", "in_list_view": 1},
    {"fieldname": "effective_from", "label": "Effective From", "fieldtype": "Date"},
    {"fieldname": "effective_to", "label": "Effective To", "fieldtype": "Date"},
    {"fieldname": "minimum_amount", "label": "Minimum Amount", "fieldtype": "Currency", "default": "0"},
    {"fieldname": "maximum_amount", "label": "Maximum Amount", "fieldtype": "Currency", "description": "Zero means no upper limit"},
    {"fieldname": "priority", "label": "Priority", "fieldtype": "Int", "default": "0", "in_list_view": 1},
    {"fieldname": "policy_version", "label": "Policy Version", "fieldtype": "Int", "default": "1", "read_only": 1},
    {"fieldname": "allow_self_approval", "label": "Allow Self Approval", "fieldtype": "Check", "default": "0"},
    {"fieldname": "parallel_mode", "label": "Parallel Stage Mode", "fieldtype": "Select", "options": "All\nAny", "default": "All", "reqd": 1},
    {"fieldname": "stages", "label": "Approval Stages", "fieldtype": "Table", "options": "ASOUD Approval Stage", "reqd": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
    {"role": "Accounts Manager", "read": 1, "write": 1, "create": 1, "report": 1},
    {"role": "ASOUD HR Manager", "read": 1, "write": 1, "create": 1, "report": 1}
  ]
}
