{
  "doctype": "DocType",
  "name": "ASOUD Branch",
  "module": "ASOUD Core",
  "autoname": "format:{company}-{branch_code}",
  "title_field": "branch_name",
  "track_changes": 1,
  "field_order": ["branch_name", "branch_code", "company", "holding", "enabled", "address", "activity_scope", "default_warehouse", "default_cost_center", "default_cash_account", "default_bank_account", "branch_manager", "numbering_series"],
  "fields": [
    {"fieldname": "branch_name", "label": "Branch Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "branch_code", "label": "Branch Code", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "holding", "label": "Holding", "fieldtype": "Link", "options": "ASOUD Holding", "fetch_from": "company.asoud_holding", "read_only": 1},
    {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "1"},
    {"fieldname": "address", "label": "Address", "fieldtype": "Small Text"},
    {"fieldname": "activity_scope", "label": "Activity Scope", "fieldtype": "Small Text"},
    {"fieldname": "default_warehouse", "label": "Default Warehouse", "fieldtype": "Link", "options": "Warehouse"},
    {"fieldname": "default_cost_center", "label": "Default Cost Center", "fieldtype": "Link", "options": "Cost Center"},
    {"fieldname": "default_cash_account", "label": "Default Cash Account", "fieldtype": "Link", "options": "Account"},
    {"fieldname": "default_bank_account", "label": "Default Bank Account", "fieldtype": "Link", "options": "Account"},
    {"fieldname": "branch_manager", "label": "Branch Manager", "fieldtype": "Link", "options": "User"},
    {"fieldname": "numbering_series", "label": "Numbering Series", "fieldtype": "Data"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Accounts Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Accounts User", "read": 1}
  ]
}
