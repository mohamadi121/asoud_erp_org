    {"fieldname": "branch", "label": "Branch", "fieldtype": "Link", "options": "ASOUD Branch", "reqd": 1},
    {"fieldname": "treasury_account", "label": "Treasury Account", "fieldtype": "Link", "options": "ASOUD Treasury Account", "reqd": 1},
    {"fieldname": "bank_name", "label": "Bank", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "iban", "label": "IBAN", "fieldtype": "Data"},
    {"fieldname": "environment", "label": "Environment", "fieldtype": "Select", "options": "Sandbox\nProduction", "default": "Sandbox", "reqd": 1},
    {"fieldname": "provider_profile", "label": "Contracted Provider Profile", "fieldtype": "Data"},
    {"fieldname": "secret_reference", "label": "External Secret Reference", "fieldtype": "Data"},
    {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "0"}
