  "track_changes": 1,
  "field_order": ["naming_series", "transaction_type", "company", "branch", "posting_date", "source_treasury_account", "target_treasury_account", "counter_account", "counter_floating_detail", "party_type", "party", "amount", "reference_no", "remarks", "journal_entry", "status"],
  "fields": [
    {"fieldname": "naming_series", "label": "Series", "fieldtype": "Select", "options": "ASOUD-TRX-.YYYY.-.#####", "default": "ASOUD-TRX-.YYYY.-.#####", "hidden": 1},
    {"fieldname": "transaction_type", "label": "Transaction Type", "fieldtype": "Select", "options": "Receipt\nPayment\nTransfer\nPetty Cash Funding", "reqd": 1, "in_list_view": 1},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "branch", "label": "Branch", "fieldtype": "Link", "options": "ASOUD Branch", "reqd": 1, "in_list_view": 1},
    {"fieldname": "posting_date", "label": "Posting Date", "fieldtype": "Date", "reqd": 1, "in_list_view": 1},
    {"fieldname": "source_treasury_account", "label": "Source Treasury Account", "fieldtype": "Link", "options": "ASOUD Treasury Account"},
    {"fieldname": "target_treasury_account", "label": "Target Treasury Account", "fieldtype": "Link", "options": "ASOUD Treasury Account"},
    {"fieldname": "counter_account", "label": "Counter Account", "fieldtype": "Link", "options": "Account"},
    {"fieldname": "counter_floating_detail", "label": "Counter Floating Detail", "fieldtype": "Link", "options": "ASOUD Floating Detail"},
    {"fieldname": "party_type", "label": "Party Type", "fieldtype": "Select", "options": "\nCustomer\nSupplier\nEmployee"},
