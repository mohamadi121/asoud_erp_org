{
  "doctype": "DocType",
  "name": "ASOUD User Access Schedule",
  "module": "ASOUD Core",
  "autoname": "format:ACC-SCH-{#####}",
  "track_changes": 1,
  "field_order": ["user", "company", "branch", "starts_on", "ends_on", "weekdays", "from_time", "to_time", "enabled"],
  "fields": [
    {"fieldname": "user", "label": "User", "fieldtype": "Link", "options": "User", "reqd": 1, "in_list_view": 1},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "in_list_view": 1},
    {"fieldname": "branch", "label": "Branch", "fieldtype": "Link", "options": "ASOUD Branch", "in_list_view": 1},
    {"fieldname": "starts_on", "label": "Starts On", "fieldtype": "Date"},
    {"fieldname": "ends_on", "label": "Ends On", "fieldtype": "Date"},
    {"fieldname": "weekdays", "label": "Weekdays", "fieldtype": "Data", "description": "Comma-separated 0=Monday through 6=Sunday"},
    {"fieldname": "from_time", "label": "From Time", "fieldtype": "Time"},
    {"fieldname": "to_time", "label": "To Time", "fieldtype": "Time"},
    {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "1", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1},
    {"role": "Accounts Manager", "read": 1, "write": 1, "create": 1, "report": 1}
  ]
}

