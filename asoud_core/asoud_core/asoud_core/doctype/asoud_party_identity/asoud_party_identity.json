{
  "doctype": "DocType",
  "name": "ASOUD Party Identity",
  "module": "ASOUD Core",
  "autoname": "naming_series:",
  "title_field": "display_name",
  "search_fields": "display_name,national_id,mobile,email",
  "track_changes": 1,
  "field_order": [
    "naming_series", "company", "branch", "holding", "person_type", "display_name",
    "first_name", "last_name", "father_name", "birth_certificate_number",
    "birth_place", "company_name", "gender", "birth_date",
    "national_id", "registration_number", "economic_code", "phone", "mobile",
    "email", "website", "province", "city", "address_line", "postal_code",
    "latitude", "longitude", "description", "enabled", "roles", "opening_balances"
  ],
  "fields": [
    {"fieldname": "naming_series", "label": "Naming Series", "fieldtype": "Select", "options": "PARTY-.#####", "default": "PARTY-.#####", "hidden": 1, "reqd": 1},
    {"fieldname": "company", "label": "Primary Company", "fieldtype": "Link", "options": "Company", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "branch", "label": "Default Branch", "fieldtype": "Link", "options": "ASOUD Branch", "in_standard_filter": 1},
    {"fieldname": "holding", "label": "Holding", "fieldtype": "Link", "options": "ASOUD Holding", "read_only": 1, "in_standard_filter": 1},
    {"fieldname": "person_type", "label": "Person Type", "fieldtype": "Select", "options": "Natural\nLegal", "default": "Natural", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "display_name", "label": "Display Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "first_name", "label": "First Name", "fieldtype": "Data", "depends_on": "eval:doc.person_type=='Natural'"},
    {"fieldname": "last_name", "label": "Last Name", "fieldtype": "Data", "depends_on": "eval:doc.person_type=='Natural'"},
    {"fieldname": "father_name", "label": "Father Name", "fieldtype": "Data", "depends_on": "eval:doc.person_type=='Natural'"},
    {"fieldname": "birth_certificate_number", "label": "Birth Certificate Number", "fieldtype": "Data", "depends_on": "eval:doc.person_type=='Natural'"},
    {"fieldname": "birth_place", "label": "Birth Certificate Place of Issue", "fieldtype": "Data", "depends_on": "eval:doc.person_type=='Natural'"},
    {"fieldname": "company_name", "label": "Legal Entity Name", "fieldtype": "Data", "depends_on": "eval:doc.person_type=='Legal'"},
    {"fieldname": "gender", "label": "Gender", "fieldtype": "Link", "options": "Gender", "depends_on": "eval:doc.person_type=='Natural'"},
    {"fieldname": "birth_date", "label": "Birth Date", "fieldtype": "Date", "depends_on": "eval:doc.person_type=='Natural'"},
    {"fieldname": "national_id", "label": "National ID", "fieldtype": "Data", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "registration_number", "label": "Registration Number", "fieldtype": "Data", "depends_on": "eval:doc.person_type=='Legal'"},
    {"fieldname": "economic_code", "label": "Economic Code", "fieldtype": "Data", "depends_on": "eval:doc.person_type=='Legal'"},
    {"fieldname": "phone", "label": "Phone", "fieldtype": "Data"},
    {"fieldname": "mobile", "label": "Mobile", "fieldtype": "Data", "options": "Phone"},
    {"fieldname": "email", "label": "Email", "fieldtype": "Data", "options": "Email"},
    {"fieldname": "website", "label": "Website", "fieldtype": "Data", "options": "URL"},
    {"fieldname": "province", "label": "Province", "fieldtype": "Data"},
    {"fieldname": "city", "label": "City", "fieldtype": "Data"},
    {"fieldname": "address_line", "label": "Address", "fieldtype": "Small Text"},
    {"fieldname": "postal_code", "label": "Postal Code", "fieldtype": "Data"},
    {"fieldname": "latitude", "label": "Latitude", "fieldtype": "Float", "precision": "8"},
    {"fieldname": "longitude", "label": "Longitude", "fieldtype": "Float", "precision": "8"},
    {"fieldname": "description", "label": "Description", "fieldtype": "Small Text"},
    {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "1", "in_list_view": 1},
    {"fieldname": "roles", "label": "Roles and Codes", "fieldtype": "Table", "options": "ASOUD Party Role"},
    {"fieldname": "opening_balances", "label": "Opening Balances", "fieldtype": "Table", "options": "ASOUD Party Opening Balance"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Accounts Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Sales Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Purchase Manager", "read": 1, "write": 1, "create": 1},
    {"role": "ASOUD HR Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Accounts User", "read": 1},
    {"role": "Sales User", "read": 1},
    {"role": "Purchase User", "read": 1},
    {"role": "ASOUD HR User", "read": 1}
  ]
}
