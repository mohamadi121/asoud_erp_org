{
  "doctype": "DocType",
  "name": "ASOUD Treasury Account",
  "module": "ASOUD Core",
  "autoname": "field:account_key",
  "title_field": "account_title",
  "track_changes": 1,
  "field_order": ["account_key", "account_title", "account_code", "treasury_type", "company", "branch", "ledger_account", "bank_account", "custodian", "floating_detail", "maximum_balance", "enabled"],
  "fields": [
    {"fieldname": "account_key", "label": "Account Key", "fieldtype": "Data", "hidden": 1, "unique": 1, "no_copy": 1},
    {"fieldname": "account_title", "label": "Account Title", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "account_code", "label": "Account Code", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "treasury_type", "label": "Treasury Type", "fieldtype": "Select", "options": "Bank\nCash\nPetty Cash", "reqd": 1, "in_list_view": 1},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "branch", "label": "Branch", "fieldtype": "Link", "options": "ASOUD Branch", "reqd": 1, "in_list_view": 1},
    {"fieldname": "ledger_account", "label": "Ledger Account", "fieldtype": "Link", "options": "Account", "reqd": 1},
    {"fieldname": "bank_account", "label": "ERPNext Bank Account", "fieldtype": "Link", "options": "Bank Account", "depends_on": "eval:doc.treasury_type=='Bank'"},
    {"fieldname": "custodian", "label": "Custodian", "fieldtype": "Link", "options": "User", "depends_on": "eval:doc.treasury_type!='Bank'"},
    {"fieldname": "floating_detail", "label": "Floating Detail", "fieldtype": "Link", "options": "ASOUD Floating Detail"},
    {"fieldname": "maximum_balance", "label": "Maximum Balance", "fieldtype": "Currency", "non_negative": 1},
    {"fieldname": "enabled", "label": "Enabled", "fieldtype": "Check", "default": "1", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Accounts Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Accounts User", "read": 1}
  ]
}
