{
  "doctype": "DocType",
  "name": "ASOUD Petty Cash Claim",
  "module": "ASOUD Core",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "field_order": ["naming_series", "company", "branch", "petty_cash_account", "custodian", "posting_date", "expenses", "total_amount", "remarks", "journal_entry", "status"],
  "fields": [
    {"fieldname": "naming_series", "label": "Series", "fieldtype": "Select", "options": "ASOUD-PC-.YYYY.-.#####", "default": "ASOUD-PC-.YYYY.-.#####", "hidden": 1},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "branch", "label": "Branch", "fieldtype": "Link", "options": "ASOUD Branch", "reqd": 1, "in_list_view": 1},
    {"fieldname": "petty_cash_account", "label": "Petty Cash Account", "fieldtype": "Link", "options": "ASOUD Treasury Account", "reqd": 1},
    {"fieldname": "custodian", "label": "Custodian", "fieldtype": "Link", "options": "User", "reqd": 1},
    {"fieldname": "posting_date", "label": "Posting Date", "fieldtype": "Date", "reqd": 1},
    {"fieldname": "expenses", "label": "Expenses", "fieldtype": "Table", "options": "ASOUD Petty Cash Expense", "reqd": 1},
    {"fieldname": "total_amount", "label": "Total Amount", "fieldtype": "Currency", "read_only": 1, "in_list_view": 1},
    {"fieldname": "remarks", "label": "Remarks", "fieldtype": "Small Text", "reqd": 1},
    {"fieldname": "journal_entry", "label": "Journal Entry", "fieldtype": "Link", "options": "Journal Entry", "read_only": 1, "no_copy": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Draft\nSettled\nCancelled", "default": "Draft", "read_only": 1, "in_list_view": 1}
