  "fields": [
    {"fieldname": "naming_series", "label": "Series", "fieldtype": "Select", "options": "ASOUD-BANK-IMP-.YYYY.-.#####", "default": "ASOUD-BANK-IMP-.YYYY.-.#####", "hidden": 1},
