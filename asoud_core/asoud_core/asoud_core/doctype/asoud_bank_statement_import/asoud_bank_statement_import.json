    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1},
    {"fieldname": "branch", "label": "Branch", "fieldtype": "Link", "options": "ASOUD Branch", "reqd": 1},
    {"fieldname": "bank_connection", "label": "Bank Connection", "fieldtype": "Link", "options": "ASOUD Bank Connection", "reqd": 1},
    {"fieldname": "file_name", "label": "Source File Name", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "file_checksum", "label": "Source SHA-256", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "imported_at", "label": "Imported At", "fieldtype": "Datetime", "reqd": 1},
    {"fieldname": "imported_by", "label": "Imported By", "fieldtype": "Link", "options": "User", "reqd": 1},
    {"fieldname": "row_count", "label": "Row Count", "fieldtype": "Int", "read_only": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Imported\nPartially Reconciled\nReconciled", "default": "Imported", "read_only": 1}
