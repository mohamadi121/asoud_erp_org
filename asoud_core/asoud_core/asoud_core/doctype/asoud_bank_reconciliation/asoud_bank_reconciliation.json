{
  "doctype": "DocType",
  "name": "ASOUD Bank Reconciliation",
  "module": "ASOUD Core",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "field_order": ["naming_series", "company", "branch", "treasury_account", "from_date", "to_date", "system_balance", "statement_balance", "difference", "reference", "remarks", "status"],
  "fields": [
    {"fieldname": "naming_series", "label": "Series", "fieldtype": "Select", "options": "ASOUD-BANK-REC-.YYYY.-.#####", "default": "ASOUD-BANK-REC-.YYYY.-.#####", "hidden": 1},
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1},
    {"fieldname": "branch", "label": "Branch", "fieldtype": "Link", "options": "ASOUD Branch", "reqd": 1},
    {"fieldname": "treasury_account", "label": "Bank Treasury Account", "fieldtype": "Link", "options": "ASOUD Treasury Account", "reqd": 1},
    {"fieldname": "from_date", "label": "From Date", "fieldtype": "Date", "reqd": 1},
    {"fieldname": "to_date", "label": "To Date", "fieldtype": "Date", "reqd": 1},
    {"fieldname": "system_balance", "label": "System Balance", "fieldtype": "Currency", "read_only": 1},
    {"fieldname": "statement_balance", "label": "Statement Balance", "fieldtype": "Currency", "reqd": 1},
    {"fieldname": "difference", "label": "Difference", "fieldtype": "Currency", "read_only": 1, "in_list_view": 1},
    {"fieldname": "reference", "label": "Statement Reference", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "remarks", "label": "Remarks", "fieldtype": "Small Text", "reqd": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Draft\nReconciled\nException\nCancelled", "default": "Draft", "read_only": 1}
